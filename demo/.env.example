# MyRealTrip Souvenir Assistant Demo
# 현재 배포에 필수 환경변수는 없습니다.

# Vercel 배포 후 README 또는 제출 문항에 기록할 공개 URL입니다.
# 애플리케이션 런타임에서는 아직 사용하지 않습니다.
NEXT_PUBLIC_DEMO_URL=https://mrt-souvenir.vercel.app

# 향후 실제 데이터 소스를 연결할 때 사용할 수 있는 예시 값입니다.
# MVP에서는 sample/mock/estimated/needsVerification 데이터만 사용합니다.
NEXT_PUBLIC_DATA_MODE=sample
