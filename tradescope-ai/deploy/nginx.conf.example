# Nginx reverse proxy example (use instead of Caddy if Nginx is already on the server).
# 1) sudo cp nginx.conf.example /etc/nginx/sites-available/tradescope && sudo ln -s ../sites-available/tradescope /etc/nginx/sites-enabled/
# 2) sudo certbot --nginx -d trade.example.com      (issues HTTPS certificates)
server {
    listen 80;
    server_name trade.example.com;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
