# systemd unit for running the standalone build without Docker.
# sudo cp tradescope.service.example /etc/systemd/system/tradescope.service
# sudo systemctl daemon-reload && sudo systemctl enable --now tradescope
[Unit]
Description=TradeScope AI (Next.js standalone)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/tradescope-ai
# copy your .env.local to /opt/tradescope-ai first (optional — without it the simulation engine runs)
EnvironmentFile=-/opt/tradescope-ai/.env.local
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# hardening — the only runtime writes are the /admin settings in .data
#   sudo mkdir -p /opt/tradescope-ai/.data && sudo chown www-data: /opt/tradescope-ai/.data && sudo chmod 700 /opt/tradescope-ai/.data
ReadWritePaths=/opt/tradescope-ai/.data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
