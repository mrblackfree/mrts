# =============================================================================
# TradeScope AI — environment variables
# Copy to `.env.local` (cp .env.example .env.local). Every value is OPTIONAL:
# with no AI_API_KEY the app runs fully on the built-in KR-PH simulation engine.
# AI_* values are read at request time — change them and restart, no rebuild needed.
# =============================================================================

# ---- AI engine (any OpenAI-compatible /chat/completions endpoint) ----------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Fallback to the simulation engine if the LLM does not answer within this time.
AI_TIMEOUT_MS=15000

# Optional tuning (leave unset for maximum provider compatibility)
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=1200
# AI_JSON_MODE=false        # true => sends response_format: {"type":"json_object"}
# AI_DISABLED=false         # true => force the simulation engine even with a key

# ---- Provider examples ------------------------------------------------------
# 모두의 AI 실험실 공유 키 : AI_BASE_URL=<안내받은 OpenAI 호환 Base URL>   AI_MODEL=<안내받은 모델명>
# OpenAI                   : AI_BASE_URL=https://api.openai.com/v1           AI_MODEL=gpt-4o-mini
# Anthropic (Claude)       : AI_BASE_URL=https://api.anthropic.com/v1        AI_MODEL=<Claude model id>
# Ollama (same machine)    : AI_BASE_URL=http://localhost:11434/v1           AI_MODEL=llama3.1   AI_API_KEY=ollama
# Ollama (from Docker)     : AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=llama3.1   AI_API_KEY=ollama

# ---- Official data connectors (used by `npm run data:sync` / GitHub Actions) ----
# 공공데이터포털(data.go.kr) 서비스키 — 「관세청_품목별 국가별 수출입실적(GW)」「관세청_관세환율정보(GW)」 활용신청(자동승인)
# DATA_GO_KR_SERVICE_KEY=
# UN Comtrade 구독키 (선택, 없으면 키 없는 공개 API 사용)
# COMTRADE_API_KEY=
# 신뢰도 센터 링크 — NEXT_PUBLIC_* 값은 빌드 시점에 번들에 포함되므로 `npm run build` 전에 설정 (Docker는 build arg)
# NEXT_PUBLIC_DATA_FEEDBACK_URL=https://github.com/<owner>/<repo>/issues/new?labels=data
# NEXT_PUBLIC_OVERRIDES_EDIT_URL=https://github.com/<owner>/<repo>/edit/main/tradescope-ai/src/data/verified-overrides.json

# ---- LLM cost guard (per server instance) ----------------------------------
# AI_MAX_CALLS_PER_IP_PER_HOUR=30
# AI_DAILY_BUDGET=500

# ---- Server / Docker --------------------------------------------------------
# PORT=3000                 # port of the Node server (standalone / next start)
# APP_PORT=3000             # host port published by docker compose
# DOMAIN=trade.example.com  # used by `docker compose --profile https` (Caddy auto-HTTPS)
